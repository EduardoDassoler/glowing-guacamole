<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Minha Página de Login</title>
</head>
<body>

    <h2>Acesse o Sistema</h2>
    
    <form>
        <!-- Campo de E-mail -->
        <label for="email">E-mail:</label><br>
        <input type="email" id="email" placeholder="seu-email@dominio.com" required><br><br>

        <!-- Campo de Senha -->
        <label for="senha">Senha:</label><br>
        <input type="password" id="senha" placeholder="Digite sua senha" required><br><br>

        <!-- Botão de Enviar -->
        <button type="submit">Entrar</button>
    </form>

</body>
</html>
